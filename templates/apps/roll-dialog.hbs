<div class="heisty-roll-dialog-body">
  <div class="hrd-summary">
    <div class="hrd-pool">
      <span class="hrd-pool-num">{{base}}</span>
      <span class="hrd-pool-lbl">base pool</span>
    </div>
    <div class="hrd-headline">
      <span class="hrd-label">{{label}}</span>
      <span class="hrd-sub">{{subtitle}} &middot; 5 or 6 is a Success</span>
    </div>
  </div>

  {{#if hasVitPenalty}}<p class="hrd-note warn"><i class="fa-solid fa-heart-crack"></i> Vitality {{heSigned vitPenalty}} dice will apply.</p>{{/if}}
  <p class="hrd-note{{#if band.atLimit}} warn{{/if}}"><i class="fa-solid fa-triangle-exclamation"></i> Alert {{alertValue}}/{{alertLimit}} &mdash; <strong>{{band.label}}</strong>. {{band.description}}</p>

  {{#if hasOpposers}}
  <div class="form-group">
    <label>Opposed by <span class="dim">(it rolls first)</span></label>
    <select name="opposed">
      <option value="">&mdash; not opposed: use the Difficulty below &mdash;</option>
      {{#each opposers}}<option value="{{this.value}}">{{this.label}}</option>{{/each}}
    </select>
  </div>
  <p class="hrd-note"><i class="fa-solid fa-scale-balanced"></i> A resisting creature rolls its pool first; its Successes + 1 become your Difficulty (a tie goes to the world). The modifier and the Alert below then apply as usual.</p>
  {{/if}}

  <div class="form-row">
    <div class="form-group">
      <label>Difficulty <span class="dim">(Successes needed)</span></label>
      <input type="number" name="difficulty" value="{{defaultDifficulty}}" min="1" max="8" list="heisty-diffs" autofocus />
      <datalist id="heisty-diffs">
        {{#each difficulties}}<option value="{{@key}}" label="{{this.label}}"></option>{{/each}}
      </datalist>
    </div>
    <div class="form-group">
      <label>Difficulty modifier <span class="dim">(cover, Perks, Flaws)</span></label>
      <input type="number" name="modifier" value="0" min="-5" max="5" title="e.g. −2 on Stealth against something you have cover from" />
    </div>
  </div>

  {{#if hasAlertDiff}}
  <div class="form-group checkbox-group">
    <label><input type="checkbox" name="applyAlert" checked /> Apply Alert penalty (+{{alertDiff}} Difficulty{{#if isStealth}}, Stealth{{/if}}{{#if band.atLimit}}, Full Alert{{/if}})</label>
  </div>
  {{/if}}

  <div class="form-row">
    <div class="form-group">
      <label>Bonus dice <span class="dim">(Assist, Perk, Signature, intel)</span></label>
      <input type="number" name="bonus" value="0" min="0" max="20" />
    </div>
    <div class="form-group">
      <label>Silk dice <span class="dim">(bought with SP)</span></label>
      <input type="number" name="silk" value="0" min="0" max="20" />
    </div>
    <div class="form-group">
      <label>Penalty dice</label>
      <input type="number" name="penalty" value="0" min="0" max="20" />
    </div>
  </div>
  <p class="hrd-note hrd-cap-note"><i class="fa-solid fa-hand"></i> At most <strong>+{{bonusCap}} bonus dice</strong> per roll from Assists, Perks, Signature Moves and intel together. Silk dice (Overclock's included) don't count toward the limit.<span class="hrd-cap-over" hidden> Only +{{bonusCap}} will be added.</span></p>
</div>
