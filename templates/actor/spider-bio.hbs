<section class="tab heisty-tab bio-tab" data-tab="bio" data-group="primary">

  <div class="panel">
    <h3 class="panel-title">Biography</h3>
    {{#if editable}}
    <prose-mirror name="system.biography" button="true" editable="true" toggled="false"
                  value="{{system.biography}}">{{{enrichedBio}}}</prose-mirror>
    {{else}}
    <div class="prose">{{{enrichedBio}}}</div>
    {{/if}}
  </div>

  <div class="panel">
    <h3 class="panel-title">The Waiting Web <span class="panel-sub">your backup spider, ready to draw</span></h3>
    {{#if editable}}
    <prose-mirror name="system.details.waitingWeb" button="true" editable="true" toggled="false"
                  value="{{system.details.waitingWeb}}">{{{enrichedWaitingWeb}}}</prose-mirror>
    {{else}}
    <div class="prose">{{{enrichedWaitingWeb}}}</div>
    {{/if}}
  </div>

  <div class="panel">
    <h3 class="panel-title">Notes</h3>
    {{#if editable}}
    <prose-mirror name="system.details.notes" button="true" editable="true" toggled="false"
                  value="{{system.details.notes}}">{{{enrichedNotes}}}</prose-mirror>
    {{else}}
    <div class="prose">{{{enrichedNotes}}}</div>
    {{/if}}
  </div>
</section>
