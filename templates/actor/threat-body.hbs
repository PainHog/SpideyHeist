<section class="threat-body">

  <div class="panel">
    <h3 class="panel-title">Action Pools
      <span class="panel-sub">click to roll &middot; each die 5+ is a Success &middot; opposing a spider, Successes + 1 = its Difficulty</span>
      {{#if editable}}<a class="panel-add" data-action="rollAdd" title="Add a pool"><i class="fa-solid fa-plus"></i></a>{{/if}}
    </h3>
    <div class="threat-rolls">
      {{#each rolls}}
      <div class="threat-roll" data-index="{{this.index}}">
        <button type="button" class="roll-pool-btn" data-action="rollThreat" data-index="{{this.index}}"
                title="Roll {{this.pool}}d6">
          <span class="pool-num">{{this.pool}}</span><i class="fa-solid fa-dice-d6"></i>
        </button>
        <input class="roll-label" type="text" name="system.rolls.{{this.index}}.label" value="{{this.label}}" placeholder="Action" />
        <input class="roll-value" type="number" min="0" name="system.rolls.{{this.index}}.pool" value="{{this.pool}}" />
        <input class="roll-note" type="text" name="system.rolls.{{this.index}}.note" value="{{this.note}}" placeholder="note" />
        {{#if @root.editable}}<a class="roll-remove" data-action="rollRemove" data-index="{{this.index}}" title="Remove"><i class="fa-solid fa-xmark"></i></a>{{/if}}
      </div>
      {{else}}
      <p class="empty-hint">No action pools yet.</p>
      {{/each}}
    </div>
  </div>

  {{#if editable}}
  <div class="panel automation-panel">
    <h3 class="panel-title">Heist automation
      <span class="panel-sub">blank = the creature table{{#if automation.guessed}} ({{automation.guessed}}){{/if}}</span>
    </h3>
    <div class="automation-grid">
      <label class="auto-field"><span>Creature</span>
        <select name="system.automation.key">
          <option value="">— match by name —</option>
          {{#each automation.keys}}<option value="{{this.key}}" {{#if this.selected}}selected{{/if}}>{{this.key}}</option>{{/each}}
        </select>
      </label>
      <label class="auto-field"><span>Alert per round</span>
        <input type="number" name="system.automation.perRound" value="{{automation.perRound}}" placeholder="{{automation.defaults.perRound}}" />
      </label>
      <label class="auto-field"><span>Wakes at Alert</span>
        <input type="number" name="system.automation.wakeAt" value="{{automation.wakeAt}}" placeholder="{{automation.defaults.wakeAt}}" />
      </label>
      <label class="auto-field"><span>Hunts at Alert</span>
        <input type="number" name="system.automation.huntAt" value="{{automation.huntAt}}" placeholder="{{automation.defaults.huntAt}}" />
      </label>
      <label class="auto-field"><span>Roams</span>
        <select name="system.automation.roams">
          <option value="">— table ({{automation.defaults.roams}}) —</option>
          {{#each automation.roams}}<option value="{{this.key}}" {{#if this.selected}}selected{{/if}}>{{this.key}}</option>{{/each}}
        </select>
      </label>
      <label class="auto-field"><span>Attack pool #</span>
        <input type="number" min="0" name="system.automation.attackIndex" value="{{automation.attackIndex}}" placeholder="{{automation.defaults.attackIndex}}" />
      </label>
      <label class="auto-field"><span>Human row</span>
        <select name="system.automation.humanRow">
          <option value="">— not a human —</option>
          {{#each automation.humanRows}}<option value="{{this.key}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}
        </select>
      </label>
    </div>
    <p class="auto-hint dim">Attack pool # counts the action pools above from 0. Leave a field blank to use the Chapter 16 stat block.</p>
  </div>
  {{/if}}

  <div class="threat-fields">
    {{#*inline "threatField"}}
    <div class="panel threat-field">
      <h3 class="panel-title">{{label}}</h3>
      {{#if @root.editable}}
      <prose-mirror name="system.{{field}}" toggled data-document-uuid="{{@root.document.uuid}}"
                    value="{{value}}">{{{enriched}}}</prose-mirror>
      {{else}}
      <div class="prose">{{{enriched}}}</div>
      {{/if}}
    </div>
    {{/inline}}

    {{> threatField label="Passive" field="passive" value=system.passive enriched=enriched.passive}}
    {{> threatField label="Senses" field="senses" value=system.senses enriched=enriched.senses}}
    {{> threatField label="Escalation" field="escalation" value=system.escalation enriched=enriched.escalation}}
    {{> threatField label="Weakness" field="weakness" value=system.weakness enriched=enriched.weakness}}
    {{> threatField label="Notes" field="notes" value=system.notes enriched=enriched.notes}}
    {{> threatField label="Description" field="biography" value=system.biography enriched=enriched.biography}}
  </div>
</section>
