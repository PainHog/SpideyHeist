<header class="heisty-header spider-header">
  <div class="portrait-wrap">
    <img class="portrait" src="{{actor.img}}" data-action="editImage" data-edit="img"
         alt="{{actor.name}}" title="Change portrait" />
    <div class="vitality-chip vit-{{system.vitality.state}}">
      <i class="fa-solid fa-heart-pulse"></i> {{vitalityState.label}}
    </div>
  </div>

  <div class="identity">
    <input class="spider-name" type="text" name="name" value="{{actor.name}}" placeholder="Name your spider" />
    <div class="identity-row">
      <input class="concept" type="text" name="system.details.concept"
             value="{{system.details.concept}}" placeholder="Concept — e.g. 'reluctant getaway driver'" />
      <input class="pronouns" type="text" name="system.details.pronouns"
             value="{{system.details.pronouns}}" placeholder="Pronouns" />
    </div>
    <div class="identity-tags">
      {{#if species}}<span class="tag species-tag"><i class="fa-solid fa-spider"></i> {{species.name}}</span>
      {{else}}<span class="tag tag-empty">No Species</span>{{/if}}
      {{#if role}}<span class="tag role-tag"><i class="fa-solid fa-user-secret"></i> {{role.name}}</span>
      {{else}}<span class="tag tag-empty">No Role</span>{{/if}}
      {{#if showHeistStatus}}<span class="tag heist-status-tag hs-{{heistStatus.cls}}" title="Heist status"><i class="fa-solid fa-mask"></i> {{heistStatus.label}}</span>{{/if}}
      {{#if replacement}}<span class="tag heist-status-tag hs-replacement" title="Drawn from the Waiting Web"><i class="fa-solid fa-diagram-project"></i> Replacement</span>{{/if}}
      {{#if camouflaged}}<span class="tag heist-status-tag hs-camo" title="Wait, Was That There Before?: Stealth −2 until you move"><i class="fa-solid fa-eye-slash"></i> Holding still</span>{{/if}}
    </div>
    {{#if pending.length}}
    <div class="pending-chips" title="Queued bonuses: used up by your next roll unless marked otherwise">
      {{#each pending}}
      <span class="pending-chip" title="{{this.text}}"><i class="fa-solid fa-dice-d6"></i> {{this.label}} <span class="pc-text">{{this.text}}</span>
        {{#if @root.isGM}}<a class="pc-remove" data-action="removePending" data-pending-id="{{this.id}}" title="Remove"><i class="fa-solid fa-xmark"></i></a>{{/if}}
      </span>
      {{/each}}
    </div>
    {{/if}}
  </div>

  <div class="header-stats">
    <div class="stat-block">
      <span class="stat-value" title="{{speedNotes}}">{{system.speed.effective}}</span>
      <span class="stat-label"><i class="fa-solid fa-shoe-prints"></i> Speed</span>
      {{#if system.speed.carrying}}<span class="stat-note" title="{{speedNotes}}">carrying</span>
      {{else if vitalityState.assisted}}<span class="stat-note" title="Critical: can't move on your own — an adjacent crewmate can bring you along at half their Speed.">assisted</span>
      {{else if vitalityState.halfSpeed}}<span class="stat-note">halved</span>{{/if}}
    </div>
    <div class="stat-block silk-block">
      <span class="stat-value">{{system.silk.value}}<span class="stat-max">/{{system.silk.max}}</span></span>
      <span class="stat-label"><i class="fa-solid fa-diagram-project"></i> Silk</span>
    </div>
    <div class="stat-block">
      <span class="stat-value">{{system.advancement.value}}</span>
      <span class="stat-label"><i class="fa-solid fa-trophy"></i> AP</span>
      {{#if canAdvance}}<button type="button" class="advance-btn" data-action="advance" title="Spend Advancement Points">Advance</button>{{/if}}
    </div>
  </div>
</header>
