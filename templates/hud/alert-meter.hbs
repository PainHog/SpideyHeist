<div class="alert-meter-inner band-{{state.key}} {{#if collapsed}}collapsed{{/if}}">
  <div class="am-grip heisty-alert-grip">
    <span class="am-title"><i class="fa-solid fa-triangle-exclamation"></i> The Alert</span>
    <button type="button" class="am-toggle" data-action="toggle" title="Collapse / expand">
      <i class="fa-solid fa-chevron-{{#if collapsed}}down{{else}}up{{/if}}"></i>
    </button>
  </div>

  {{#unless collapsed}}
  <div class="am-body">
    <div class="am-readout">
      <span class="am-value">{{value}}</span><span class="am-limit">/ {{limit}}</span>
      <span class="am-band">{{state.label}}</span>
    </div>

    <div class="am-bar">
      <div class="am-fill" style="width:{{pct}}%"></div>
      {{#if atLimit}}<span class="am-locked">FULL ALERT</span>{{/if}}
    </div>

    <p class="am-desc">{{state.description}}</p>

    {{#if phaseLabel}}
    <div class="am-heist-row">
      <span class="am-heist-phase" title="{{heistName}}">{{phaseLabel}}{{#if inPlay}} · round {{round}}{{/if}}</span>
      <button type="button" data-action="tracker" title="Open the Heist Tracker"><i class="fa-solid fa-route"></i></button>
      {{#if isGM}}{{#if inPlay}}<button type="button" data-action="endRound" title="End the round (creatures, procedures, the clock)"><i class="fa-solid fa-hourglass-end"></i></button>{{/if}}{{/if}}
    </div>
    {{/if}}

    {{#if hasPending}}
    <div class="am-pending">
      <span class="am-pending-title">Proposed changes</span>
      {{#each pending}}
      <div class="am-pending-row">
        <span class="am-pending-text">{{this.text}}</span>
        <button type="button" data-action="confirm" data-event-id="{{this.eventId}}" title="Apply it"><i class="fa-solid fa-check"></i></button>
        <button type="button" data-action="reject" data-event-id="{{this.eventId}}" title="Drop it"><i class="fa-solid fa-xmark"></i></button>
      </div>
      {{/each}}
    </div>
    {{/if}}

    {{#if isGM}}
    <div class="am-controls">
      <button type="button" data-action="bump" data-delta="-1" {{#if atLimit}}disabled title="Full Alert: nothing lowers the Alert for the rest of the heist"{{else}}title="Critical Success at final Difficulty 3+ (−1, never below 0)"{{/if}}>−1</button>
      <button type="button" data-action="bump" data-delta="1" {{#if atLimit}}disabled title="Full Alert: the Alert stays at the Limit"{{else}}title="Failure / Partial / spotted (+1) — one event, one trigger: the largest"{{/if}}>+1</button>
      <button type="button" data-action="bump" data-delta="2" {{#if atLimit}}disabled title="Full Alert: the Alert stays at the Limit"{{else}}title="Botch / confirmed alert / spider Out / Loud Failure (+2)"{{/if}}>+2</button>
      <input type="number" name="alertValue" value="{{value}}" min="0" max="{{limit}}" title="Set exact Alert (stops at the Limit; locked at Full Alert)" {{#if atLimit}}disabled{{/if}} />
      <button type="button" data-action="reset" title="Reset to 0 (new heist — also clears Full Alert)"><i class="fa-solid fa-rotate-left"></i></button>
    </div>
    <div class="am-limit-row">
      <label>Limit</label>
      <select name="alertLimit">
        {{#each limits}}<option value="{{this.value}}" {{#if (heEq this.value ../limit)}}selected{{/if}}>{{this.label}} ({{this.value}})</option>{{/each}}
      </select>
      {{#if freeplay}}<button type="button" class="am-new-scene" data-action="newScene" title="New Scene: once-per-scene abilities are ready again"><i class="fa-solid fa-clapperboard"></i> New Scene</button>{{/if}}
    </div>
    {{/if}}
  </div>
  {{/unless}}
</div>
