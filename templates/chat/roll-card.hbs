<div class="heisty-roll-card heisty-card result-{{resultCss}}{{#if isBotch}} is-botch{{/if}}{{#if final}} is-final{{/if}}">
  <header class="hrc-head">
    <img class="hrc-avatar" src="{{actorImg}}" alt="" />
    <div class="hrc-title">
      <span class="hrc-actor">{{actorName}}</span>
      <span class="hrc-label">{{label}} <span class="hrc-sub">{{subtitle}}</span></span>
    </div>
    <div class="hrc-verdict-badge">{{resultLabel}}</div>
  </header>

  <div class="hrc-dice">
    {{#each faces}}<span class="die face-{{this.result}}{{#if this.success}} hit{{/if}}{{#if this.rerolled}} rerolled{{/if}}">{{this.result}}</span>{{/each}}
  </div>

  <div class="hrc-result">
    {{#if isBotch}}
      <span class="hrc-count">The pool bottomed out — one die rolled a <strong>{{botchDie}}</strong>.</span>
    {{else}}
      <span class="hrc-count"><strong>{{successes}}</strong> Success{{#if (heNeq successes 1)}}es{{/if}} vs Difficulty <strong>{{difficulty}}</strong></span>
    {{/if}}
  </div>

  <p class="hrc-blurb">{{blurb}}</p>
  {{#each notes}}<p class="hrc-note{{#if this.warn}} warn{{/if}}{{#if this.good}} good{{/if}}"><i class="fa-solid {{this.icon}}"></i> {{this.text}}</p>{{/each}}

  <div class="hrc-breakdown">
    {{#each chips}}<span class="chip {{this.cls}}">{{this.text}}</span>{{/each}}
  </div>

  {{#if alertLine}}<p class="hrc-alert-line {{alertLine.cls}}"><i class="fa-solid fa-triangle-exclamation"></i> {{alertLine.text}}</p>{{/if}}
  {{#if hasConsequences}}
  <ul class="hrc-consequences">
    {{#each consequences}}<li class="{{this.cls}}">{{this.text}}</li>{{/each}}
  </ul>
  {{/if}}
  {{#if hasHistory}}
  <ul class="hrc-history">
    {{#each history}}<li>{{this.text}}</li>{{/each}}
  </ul>
  {{/if}}
  {{#if final}}<p class="hrc-final"><i class="fa-solid fa-lock"></i> Final.</p>{{/if}}
  <div class="hrc-actions" data-heisty-actions></div>
</div>
