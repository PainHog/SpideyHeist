<div class="heisty-heist-card hhc-flaw">
  <header class="hhc-head"><i class="fa-solid fa-bolt"></i> {{flawName}} — {{actorName}}</header>
  <p>{{text}}</p>
  <div class="hhc-buttons"><button type="button" data-heist-action="flawRoll" data-owner="{{actorId}}"><i class="fa-solid fa-dice"></i> Roll {{rollLabel}}</button></div>
</div>
