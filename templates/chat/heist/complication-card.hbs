<div class="heisty-heist-card hhc-complication {{#if negated}}negated{{/if}}">
  <header class="hhc-head"><i class="fa-solid fa-dice-d6"></i> Mid-Heist Complication: {{roll}}</header>
  <p><strong>{{title}}</strong> {{text}}</p>
  <p class="hhc-sub">{{effect}}</p>
  {{#if applied.length}}<ul class="hhc-applied">{{#each applied}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
  {{#if negated}}<p class="hhc-note">Not Part of the Plan: it doesn't happen.</p>{{/if}}
  {{#if hasChoices}}
  <div class="hhc-gm" data-gm-only>
    <label>Pick another <select data-heist-change="complicationPick">{{#each choices}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select></label>
  </div>
  {{/if}}
  {{#unless negated}}{{#unless nptpUsed}}
  <div class="hhc-crew" data-crew-only>
    <select data-crew-picker></select>
    <button type="button" data-heist-action="nptp" title="4 SP, one payer, once per heist">Not Part of the Plan (4 SP)</button>
  </div>
  {{/unless}}{{/unless}}
</div>
