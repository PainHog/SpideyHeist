<div class="heisty-roll-card heisty-card threat-card">
  <header class="hrc-head">
    <img class="hrc-avatar" src="{{actorImg}}" alt="" />
    <div class="hrc-title">
      <span class="hrc-actor">{{actorName}}</span>
      <span class="hrc-label">{{label}}{{#if note}} <span class="hrc-sub">{{note}}</span>{{/if}}</span>
    </div>
    <div class="hrc-verdict-badge threat">{{successes}} Succ.</div>
  </header>

  <div class="hrc-dice">
    {{#each faces}}<span class="die face-{{this.result}}{{#if this.success}} hit{{/if}}">{{this.result}}</span>{{/each}}
  </div>

  <div class="hrc-result">
    <span class="hrc-count"><strong>{{successes}}</strong> Success{{#if (heNeq successes 1)}}es{{/if}} on {{pool}}d6</span>
  </div>
  <p class="hrc-blurb">Opposed: a spider acting against this rolls at <strong>Difficulty {{opposedDifficulty}}</strong> (its Successes + 1, so a tie goes to the world), then cover, the Alert, Perks and Flaws apply as usual. Its roll is just a count: it never Partials, Criticals or Botches.{{#if opposing}} Resisting {{opposing}}.{{/if}}</p>
  {{#if alertLine}}<p class="hrc-alert-line {{alertLine.cls}}"><i class="fa-solid fa-triangle-exclamation"></i> {{alertLine.text}}</p>{{/if}}
  <div class="hrc-actions" data-heisty-actions></div>
</div>
