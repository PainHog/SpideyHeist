<header class="heisty-header item-header type-{{item.type}}">
  <img class="item-portrait" src="{{item.img}}" data-action="editImage" data-edit="img"
       alt="{{item.name}}" title="Change icon" />
  <div class="identity">
    <input class="spider-name item-name-input" type="text" name="name" value="{{item.name}}" placeholder="Name" />
    <span class="item-type-label">{{typeLabel}}</span>
  </div>
</header>
